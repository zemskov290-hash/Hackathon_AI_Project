# Необязательно. Без этих строк агент работает на моделях подписки IDE
# и не делает платных вызовов. Скопируйте в .env и заполните только если
# нужна маршрутизация дешёвой/сильной модели и точный учёт токенов API.
# Какой класс задачи какой уровень получает — в config/routing.json, не здесь.
# .env не коммитится.

# STRAT_LLM_BASE_URL=https://openrouter.ai/api/v1
# STRAT_LLM_API_KEY=
# STRAT_MODEL_CHEAP=
# STRAT_MODEL_STRONG=

# Классификатор меток. Без ключа и без cursor-agent остаются правила, сеть не вызывается.
# Имена моделей подписки лежат в config/routing.json. Список этой учётки: agent --list-models
# STRAT_AGENT_CMD=
# STRAT_CLASSIFIER_BACKEND=auto
# STRAT_CLASSIFIER_CHEAP_MODEL=
# STRAT_CLASSIFIER_STRONG_MODEL=
# Специализированный оценщик (например Jev). Сам ключ вызов не включает:
# в config/routing.json specialized.enabled должен быть true.
# STRAT_JEV_API_KEY=
# STRAT_JEV_BASE_URL=
# STRAT_JEV_MODEL=
