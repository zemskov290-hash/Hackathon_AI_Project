# Необязательно. Без этих строк агент работает на моделях подписки IDE
# и не делает платных вызовов. Скопируйте в .env и заполните только если
# нужна маршрутизация дешёвой/сильной модели и точный учёт токенов API.
# Какой класс задачи какой уровень получает — в config/routing.json, не здесь.
# .env не коммитится.

# STRAT_LLM_BASE_URL=https://openrouter.ai/api/v1
# STRAT_LLM_API_KEY=
# STRAT_MODEL_CHEAP=
# STRAT_MODEL_STRONG=
