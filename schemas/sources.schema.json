{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/sources.schema.json",
  "title": "Источник",
  "description": "Одна строка sources.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "url_or_path", "title", "accessed", "kind", "sha256", "reliability"],
  "properties": {
    "id": { "type": "string", "pattern": "^S\\d{3,}$" },
    "url_or_path": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "kind": { "enum": ["web", "doc", "table", "interview", "synthetic", "own"] },
    "sha256": { "type": ["string", "null"] },
    "reliability": { "enum": ["high", "med", "low"] }
  }
}
