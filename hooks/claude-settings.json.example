{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import io,json,os,runpy,sys;from pathlib import Path;raw='' if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read();sys.stdin=io.StringIO(raw);hit=lambda s:[p for p in (Path(s),*Path(s).parents) if (p/'hooks'/'launch.py').is_file() and (p/'AGENTS.md').is_file()] if s else [];found=hit(os.environ.get('CURSOR_PROJECT_DIR'))+hit(os.environ.get('CLAUDE_PROJECT_DIR'))+hit(os.getcwd());data=json.loads(raw) if not found and raw.strip()[:1]=='{' else {};roots=data.get('workspace_roots') or [];found+=[p for s in ([roots] if isinstance(roots,str) else list(roots))+[data.get('cwd')] for p in hit(s)];runpy.run_path(str(found[0]/'hooks'/'launch.py'),run_name='__main__') if found else (print(json.dumps(dict(permission='allow')) if sys.argv[-1].startswith('guard_') else '{}'),sys.stderr.write('hook root not found'+chr(10)))\" guard_shell"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import io,json,os,runpy,sys;from pathlib import Path;raw='' if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read();sys.stdin=io.StringIO(raw);hit=lambda s:[p for p in (Path(s),*Path(s).parents) if (p/'hooks'/'launch.py').is_file() and (p/'AGENTS.md').is_file()] if s else [];found=hit(os.environ.get('CURSOR_PROJECT_DIR'))+hit(os.environ.get('CLAUDE_PROJECT_DIR'))+hit(os.getcwd());data=json.loads(raw) if not found and raw.strip()[:1]=='{' else {};roots=data.get('workspace_roots') or [];found+=[p for s in ([roots] if isinstance(roots,str) else list(roots))+[data.get('cwd')] for p in hit(s)];runpy.run_path(str(found[0]/'hooks'/'launch.py'),run_name='__main__') if found else (print(json.dumps(dict(permission='allow')) if sys.argv[-1].startswith('guard_') else '{}'),sys.stderr.write('hook root not found'+chr(10)))\" post_write"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import io,json,os,runpy,sys;from pathlib import Path;raw='' if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read();sys.stdin=io.StringIO(raw);hit=lambda s:[p for p in (Path(s),*Path(s).parents) if (p/'hooks'/'launch.py').is_file() and (p/'AGENTS.md').is_file()] if s else [];found=hit(os.environ.get('CURSOR_PROJECT_DIR'))+hit(os.environ.get('CLAUDE_PROJECT_DIR'))+hit(os.getcwd());data=json.loads(raw) if not found and raw.strip()[:1]=='{' else {};roots=data.get('workspace_roots') or [];found+=[p for s in ([roots] if isinstance(roots,str) else list(roots))+[data.get('cwd')] for p in hit(s)];runpy.run_path(str(found[0]/'hooks'/'launch.py'),run_name='__main__') if found else (print(json.dumps(dict(permission='allow')) if sys.argv[-1].startswith('guard_') else '{}'),sys.stderr.write('hook root not found'+chr(10)))\" stage_end"
          }
        ]
      }
    ]
  }
}
